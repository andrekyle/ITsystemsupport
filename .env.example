# Local development runs in browser-only mode by default; profiles and progress
# are saved in this browser's local storage. To use Supabase locally, set
# VITE_ENABLE_CLOUD=true below. Production builds enable Supabase automatically
# when these credentials are configured.
# Values come from your Supabase project: Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# VITE_ENABLE_CLOUD=true
# Deploy once with "investec" and once with "discovery". Tenant identity is
# stamped onto sign-ups and enforced by database row-level security.
VITE_TENANT=investec

# Server-side only — used by api/mark-answer.ts (LLM semantic fallback marker).
# From https://platform.openai.com/api-keys. No VITE_ prefix: never sent to the browser.
OPENAI_API_KEY=sk-YOUR-OPENAI-KEY
