# Copy to .env.local for local development (and set the same two variables in
# Vercel → Project → Settings → Environment Variables for deployment).
# Values come from your Supabase project: Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side only — used by api/mark-answer.ts (LLM semantic fallback marker).
# From https://platform.openai.com/api-keys. No VITE_ prefix: never sent to the browser.
OPENAI_API_KEY=sk-YOUR-OPENAI-KEY
